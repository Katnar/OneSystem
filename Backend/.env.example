# Local MongoDB instance, or replace with your MongoDB cluster connection string.
MONGO_URL=mongodb:[most-likely-our-cluster]/onesystem
PORT=3000 //match it to front dont forget
# Verification key supplied by your SSO provider. This is not an SSO token.
SSO_DECRYPT_KEY_JWT=replace-with-your-sso-verification-key
ONESYSTEM_SECRET_KEY_JWT=replace-with-the-same-app-jwt-secret
# Optional Windows DNS workaround; leave false unless needed.
IS_DEBUGGING_WINDOWS=false
