#!/bin/sh

echo "Running pre-commit checks..."

# Store the root directory
ROOT_DIR=$(pwd)

# Function to check and format a project
check_project() {
  PROJECT_DIR=$1
  PROJECT_NAME=$2

  echo "\n📁 Checking $PROJECT_NAME..."
  cd "$ROOT_DIR/$PROJECT_DIR"

  # Run Prettier to auto-format files
  echo "  Running Prettier..."
  npm run format

  if [ $? -ne 0 ]; then
    echo "  ❌ Prettier failed to format $PROJECT_NAME"
    return 1
  fi

  # Run ESLint to check for errors (including unused imports)
  # This will show warnings but won't block the commit
  echo "  Running ESLint..."
  npm run lint || echo "  ⚠️  ESLint found issues in $PROJECT_NAME (not blocking commit)"

  echo "  ✅ $PROJECT_NAME formatting complete!"
  return 0
}

# Check both projects
FRONTEND_OK=true
BACKEND_OK=true

check_project "Frontend" "Frontend" || FRONTEND_OK=false
check_project "Backend" "Backend" || BACKEND_OK=false

# Return to root
cd "$ROOT_DIR"

# Check results - only fail if Prettier failed
if [ "$FRONTEND_OK" = false ] || [ "$BACKEND_OK" = false ]; then
  echo "\n❌ Pre-commit checks failed. Commit aborted."
  echo "Prettier failed to format code in one or more projects."
  exit 1
fi

echo "\n✅ All formatting complete! Proceeding with commit."
exit 0