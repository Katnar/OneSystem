{
	"compilerOptions": {
		"target": "ES2020",
		"module": "CommonJS",
		"rootDir": "..",
		"outDir": "./dist",
		"baseUrl": ".",
		"paths": {
			"@onesystem/shared": ["../sharedFiles"],
			"@onesystem/shared/*": ["../sharedFiles/*"]
		},
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*", "../Utilities/**/*"]
}
