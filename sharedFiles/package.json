{
	"name": "@onesystem/shared-files",
	"version": "1.0.0",
	"private": true,
	"description": "Shared contracts and constants for OneSystem backend and frontend",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.js",
			"import": "./dist/index.js"
		},
		"./global": {
			"types": "./dist/global.d.ts",
			"require": "./dist/global.js",
			"import": "./dist/global.js"
		},
		"./mador": {
			"types": "./dist/mador.d.ts",
			"require": "./dist/mador.js",
			"import": "./dist/mador.js"
		},
		"./auth/*": {
			"types": "./dist/auth/*.d.ts",
			"require": "./dist/auth/*.js",
			"import": "./dist/auth/*.js"
		}
	},
	"typesVersions": {
		"*": {
			"global": ["dist/global.d.ts"],
			"mador": ["dist/mador.d.ts"],
			"auth/*": ["dist/auth/*"],
			"*": ["dist/*"]
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json"
	},
	"devDependencies": {
		"typescript": "~5.9.3"
	}
}
