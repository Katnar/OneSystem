{
	"compilerOptions": {
		"target": "ES2020",
		"module": "CommonJS",
		"moduleResolution": "node",
		"rootDir": ".",
		"outDir": "dist",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"zod": ["node_modules/zod", "../Backend/node_modules/zod", "../Frontend/node_modules/zod"],
			"zod/*": ["node_modules/zod/*", "../Backend/node_modules/zod/*", "../Frontend/node_modules/zod/*"]
		}
	},
	"include": ["**/*.ts"],
	"exclude": ["dist", "node_modules"]
}
